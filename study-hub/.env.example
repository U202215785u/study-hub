# ===== Claude API（主要 AI）=====
CLAUDE_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-6

# ===== 备选 AI（可选，用于 embedding 或 Claude 不可用时回退）=====
# KIMI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# DOUBAO_API_KEY=xxx

# ===== 默认 AI 提供方 =====
AI_DEFAULT_PROVIDER=claude

# ===== HuggingFace 镜像（国内网络）=====
HF_ENDPOINT=https://hf-mirror.com

# ===== 服务端口 =====
PORT=8741
