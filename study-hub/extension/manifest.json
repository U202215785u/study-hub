{
  "manifest_version": 3,
  "name": "学习中枢 - 对话采集",
  "version": "1.1",
  "description": "自动采集 AI 网站对话，回流传入知识库。支持 Claude / ChatGPT / DeepSeek / Kimi / 豆包",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chat.deepseek.com/*",
    "https://kimi.moonshot.cn/*",
    "https://www.doubao.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chat.deepseek.com/*",
        "https://kimi.moonshot.cn/*",
        "https://www.doubao.com/*"
      ],
      "js": ["adapters.js", "content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习中枢"
  }
}
