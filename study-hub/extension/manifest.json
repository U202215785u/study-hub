{
  "manifest_version": 3,
  "name": "学习中枢 - 对话采集",
  "version": "2.1",
  "description": "Study-Hub 浏览器扩展：Bing 搜索助手浮窗 + 网页剪藏 + 抖音收藏导入",
  "permissions": ["storage", "tabs", "scripting", "activeTab", "alarms", "contextMenus"],
  "host_permissions": [
    "https://*/*",
    "http://localhost:8741/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bing.com/search*"],
      "js": ["bing-assistant.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/scene-rules.json"],
      "matches": ["https://www.bing.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习中枢"
  }
}
