{
  "manifest_version": 3,
  "name": "学习中枢 - 对话采集",
  "version": "2.0",
  "description": "自动采集 AI 网站对话，支持自定义网站配置。五层记忆系统：角色/项目/工作流/会话/世界",
  "permissions": ["storage", "tabs", "scripting", "activeTab"],
  "host_permissions": [
    "https://*/*",
    "http://localhost:8741/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["adapters.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "学习中枢"
  }
}
